            "title": "Track Id",
            "type": "string"
          }
        },
        "required": [
          "album_id",
          "track_id"
        ],
        "title": "RecommendedTrackInput",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WritePostRequest": {
        "properties": {
          "album_classics": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Album Classics",
            "type": "object"
          },
          "album_ids": {
            "items": {
              "type": "string"
            },
            "title": "Album Ids",
            "type": "array"
          },
          "artist_ids": {
            "items": {
              "type": "string"
            },
            "title": "Artist Ids",
            "type": "array"
          },
          "body_mdx": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Body Mdx"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "posted_date": {
            "format": "date",
            "title": "Posted Date",
            "type": "string"
          },
          "rating": {
            "anyOf": [
              {
                "maximum": 5.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "rating_scale": {
            "default": 5,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Rating Scale",
            "type": "integer"
          },
          "recommended_tracks": {
            "items": {
              "$ref": "#/components/schemas/RecommendedTrackInput"
            },
            "title": "Recommended Tracks",
            "type": "array"
          },
          "search_index": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Search Index"
          },
          "status": {
            "default": "published",
            "enum": [
              "draft",
              "published",
              "archived"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "WritePostRequest",
        "type": "object"
      },
      "WritePostResponse": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug"
        ],
        "title": "WritePostResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Blog Backend (Lambda/Mangum)",
    "version": "0.1.0"
  },
