{
  "components": {
    "schemas": {
      "AddCategoryRequest": {
        "properties": {
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "AddCategoryRequest",
        "type": "object"
      },
      "CategoryListResponse": {
        "properties": {
          "categories": {
            "items": {
              "type": "string"
            },
            "title": "Categories",
            "type": "array"
          }
        },
        "required": [
          "categories"
        ],
        "title": "CategoryListResponse",
        "type": "object"
      },
      "CreatePostReq": {
        "properties": {
          "album_cover_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Album Cover Url"
          },
          "album_ids": {
            "items": {
              "type": "string"
            },
            "title": "Album Ids",
            "type": "array"
          },
          "artist_ids": {
            "items": {
              "type": "string"
            },
            "title": "Artist Ids",
            "type": "array"
          },
          "body_mdx": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Body Mdx"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "post_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Post Id"
          },
          "posted_date": {
            "format": "date",
            "title": "Posted Date",
            "type": "string"
          },
          "rating": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "rating_scale": {
            "default": 5,
            "title": "Rating Scale",
            "type": "integer"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "posted_date"
        ],
        "title": "CreatePostReq",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MetricsBatchRequest": {
        "properties": {
          "slugs": {
            "items": {
              "type": "string"
            },
            "title": "Slugs",
            "type": "array"
          }
        },
        "required": [
          "slugs"
        ],
        "title": "MetricsBatchRequest",
        "type": "object"
      },
      "MetricsBatchResponse": {
        "properties": {
          "data": {
            "additionalProperties": {
              "$ref": "#/components/schemas/PostMetrics"
            },
            "title": "Data",
            "type": "object"
          }
        },
        "required": [
          "data"
        ],
        "title": "MetricsBatchResponse",
        "type": "object"
      },
      "PostMetrics": {
        "properties": {
          "comments": {
            "title": "Comments",
